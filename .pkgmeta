# CurseForge packager: it packages every tagged commit pushed to GitHub.
# Files starting with a dot (.git, .github, this file...) are always left out.
package-as: GuildProfessionsRecipes

ignore:
    - Tests

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# The CurseForge app installs these with the addon: each packaged file
# carries them as its required relations (project slugs).
required-dependencies:
    - lib-guild-sync
